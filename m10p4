
def compute_ticket_price(miles):
    if miles >= 30:
        price = 12
    elif miles >= 20:
        price = 10
    elif miles >= 10:
        price = 8
    else:
        price = 5
    return price


total_tickets = 0

response = input("Do you want to buy a ticket? (Yes/No): ")

while response.lower() == "yes":
    last_name = input("Enter last name: ")
    miles = float(input("Enter miles from downtown Chicago: "))

    price = compute_ticket_price(miles)
    total_tickets = total_tickets + price

    print("Last Name:", last_name)
    print("Ticket Price: $", format(price, ",.2f"))
    print()

    response = input("Do you want to buy another ticket? (Yes/No): ")

print()
print("Total of all Tickets: $", format(total_tickets, ",.2f"))