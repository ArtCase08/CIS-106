#input
books_number = int(input("Enter the number of books purchased: "))
cost_per_book = float(input("Enter the cost per book: "))

#processing
total_cost = (books_number * cost_per_book)
if total_cost <= 50:
    shipping_cost = 25
else:
    shipping_cost = 0
total = total_cost + shipping_cost
#output

print(f"The total cost of the books and shipping is: ${total}")
print(f"The shipping cost is: ${shipping_cost}")