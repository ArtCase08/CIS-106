#input
principle = int(input("Enter the principle amount: "))
years = int(input("Enter the number of years: "))
#processing
if  principle > 100000 and years == 5:
    interest_rate = 0.06 
elif  principle >= 50000 and principle <= 100000 and years == 10:
    interest_rate = 0.05 
elif principle >= 50000 and principle <= 100000 and years == 5:
    interest_rate = 0.04
else:
    interest_rate = 0.02
first_year_interest = principle * interest_rate

#output
print(f"Principle amount: ${principle:,}")
print(f"Interest rate: {interest_rate:.2%}")
print(f"First year interest: ${first_year_interest:,.2f}")