#input
lastname = (input("Enter your last name: "))
salary = float(input("Enter your salary: "))
level = int(input("Enter your level: "))
#processing
if level >= 10:
    bonus_rate = 0.25
elif level >= 5:
    bonus_rate = 0.20
else:
    bonus_rate = 0.10

bonus = salary * bonus_rate
#output
print(f"Last name: {lastname}")
print(f"bonus: ${bonus:,.2f}")


